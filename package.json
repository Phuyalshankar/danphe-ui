{
  "name": "dolphin-native",
  "version": "5.0.0",
  "description": "Zero-WebView Native Android Framework. Compiles JSX + Tailwind CSS to 24-byte Titan binary for mobile apps & embedded devices (TV Box, Kiosk, Watch, Stereo).",
  "main": "index.js",
  "types": "src/index.d.ts",
  "keywords": [
    "android",
    "native",
    "mobile",
    "embedded",
    "framework",
    "jsx",
    "tailwind",
    "tv-box",
    "kiosk",
    "smartwatch",
    "iot",
    "zero-webview",
    "performance",
    "binary-protocol"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YOUR_USERNAME/dolphin-native-2.git"
  },
  "bugs": {
    "url": "https://github.com/YOUR_USERNAME/dolphin-native-2/issues"
  },
  "homepage": "https://github.com/YOUR_USERNAME/dolphin-native-2#readme",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./index.js"
    },
    "./hardware": {
      "types": "./src/hardware/DolphinHardwareAPI.d.ts",
      "default": "./src/hardware/DolphinHardwareAPI.js"
    },
    "./compiler": "./src/compiler/DolphinCompiler.js",
    "./framework": "./src/framework/DolphinFramework.js",
    "./protocol": "./src/protocol/DolphinBinaryProtocol.js",
    "./router": "./src/router/index.js",
    "./server": "./src/runtime/DevServer.js",
    "./cli": "./src/cli/DolphinCLI.js",
    "./*": "./*"
  },
  "bin": {
    "dolphin": "bin/dolphin.js",
    "dolphin-mobile": "bin/dolphin-mobile.js"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "echo \"Tests coming soon\" && exit 0"
  },
  "files": [
    "bin/",
    "src/",
    "runtime/",
    "index.js",
    "README.md",
    "ai.md",
    "integration.md"
  ],
  "author": "Dolphin Native Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@babel/core": "^7.24.6",
    "@babel/plugin-transform-react-jsx": "^7.29.7",
    "@babel/register": "^7.24.6",
    "@dolphin/titan-framework": "github:Phuyalshankar/dolphin-plc",
    "chokidar": "^3.5.3",
    "dolphin-server-modules": "^2.14.2",
    "express": "^4.18.2",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.14.2"
  }
}
