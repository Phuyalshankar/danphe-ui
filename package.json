{
  "name": "dolphin-native",
  "version": "5.0.0-production",
  "description": "Dolphin Native v5 — Production Framework. Compiles JSX to 24-byte Titan binary and renders natively on Android. Zero WebView, full hardware access.",
  "main": "index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./index.js"
    },
    "./hardware": {
      "types": "./src/hardware/DolphinHardwareAPI.d.ts",
      "default": "./src/hardware/DolphinHardwareAPI.js"
    },
    "./compiler": "./src/compiler/DolphinCompiler.js",
    "./framework": "./src/framework/DolphinFramework.js",
    "./protocol": "./src/protocol/DolphinBinaryProtocol.js",
    "./router": "./src/router/index.js",
    "./server": "./src/runtime/DevServer.js",
    "./cli": "./src/cli/DolphinCLI.js",
    "./*": "./*"
  },
  "bin": {
    "dolphin": "bin/dolphin.js",
    "dolphin-mobile": "bin/dolphin-mobile.js"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js"
  },
  "files": ["*"],
  "author": "Dolphin Native Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@babel/core": "^7.24.6",
    "@babel/plugin-transform-react-jsx": "^7.29.7",
    "@babel/register": "^7.24.6",
    "chokidar": "^3.5.3",
    "dolphin-server-modules": "^2.14.2",
    "express": "^4.18.2",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.14.2"
  }
}
