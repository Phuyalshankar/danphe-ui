// 🦚 Danphe-UI Native Package Module for Dolphin Language (v19.0.0-PRO)
// Architecture: Dolphin-CPP Native + ThorVG + Pure Vector Synthesizer
// Import via: import "@danphe/ui" or import "packages/ui/danphe.dolphin"

fn _getIconsMap() {
    var raw = File.read("danphe_icons.json")
    return JSON.parse(raw)
}

// 1. 👑 Pure Vector Icon Synthesizer (550+ Icons)
fn danpheIcon(id, size, circle, color) {
    var s = size || 32
    var c = true
    if (circle == false) {
        c = false
    }
    var col = color || "#38bdf8"
    var db = _getIconsMap()
    var key = "" + id
    var item = db[key]
    var pathData = ""
    if (item != null) {
        pathData = item["path"]
    } else {
        pathData = "<path d='M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z' fill='none' stroke='#64748b' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/>"
    }

    var svg = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32' width='" + s + "' height='" + s + "'>"
    if (c) {
        svg = svg + "<circle cx='16' cy='16' r='15' fill='#030712' stroke='" + col + "' stroke-opacity='0.3' stroke-width='1.2'/>"
        svg = svg + "<circle cx='16' cy='16' r='13.5' fill='#0a1324' stroke='" + col + "' stroke-width='1.4'/>"
    }
    svg = svg + "<g transform='translate(4, 4)'>" + pathData + "</g></svg>"
    return svg
}

// 2. ⏱️ Pure SVG Seven-Segment LED Display
fn danpheSevenSegment(value, theme) {
    var t = theme || "red"
    var onCol = "#ef4444"
    var offCol = "#260808"
    if (t == "amber") {
        onCol = "#f59e0b"
        offCol = "#2b1b00"
    }
    if (t == "cyan") {
        onCol = "#06b6d4"
        offCol = "#02242b"
    }
    if (t == "emerald") {
        onCol = "#10b981"
        offCol = "#02291b"
    }

    var strVal = "" + value
    var digitsHtml = ""
    var segMaps = {
        "0": 63, "1": 6, "2": 91, "3": 79, "4": 102,
        "5": 109, "6": 125, "7": 7, "8": 127, "9": 111, "-": 64, " ": 0
    }

    var strLen = len(strVal)
    loop (i, 0, strLen) {
        var ch = strVal[i]
        var mask = segMaps[ch] || 0
        var sA = offCol
        if ((mask & 1) > 0) { sA = onCol }
        var sB = offCol
        if ((mask & 2) > 0) { sB = onCol }
        var sC = offCol
        if ((mask & 4) > 0) { sC = onCol }
        var sD = offCol
        if ((mask & 8) > 0) { sD = onCol }
        var sE = offCol
        if ((mask & 16) > 0) { sE = onCol }
        var sF = offCol
        if ((mask & 32) > 0) { sF = onCol }
        var sG = offCol
        if ((mask & 64) > 0) { sG = onCol }

        digitsHtml = digitsHtml + "<svg viewBox='0 0 60 100' width='38' height='65' class='inline-block mx-0.5'>"
        digitsHtml = digitsHtml + "<polygon points='12,10 48,10 42,16 18,16' fill='" + sA + "'/>"
        digitsHtml = digitsHtml + "<polygon points='50,12 50,46 44,42 44,18' fill='" + sB + "'/>"
        digitsHtml = digitsHtml + "<polygon points='50,54 50,88 44,82 44,58' fill='" + sC + "'/>"
        digitsHtml = digitsHtml + "<polygon points='12,90 48,90 42,84 18,84' fill='" + sD + "'/>"
        digitsHtml = digitsHtml + "<polygon points='10,54 10,88 16,82 16,58' fill='" + sE + "'/>"
        digitsHtml = digitsHtml + "<polygon points='10,12 10,46 16,42 16,18' fill='" + sF + "'/>"
        digitsHtml = digitsHtml + "<polygon points='14,50 46,50 42,46 18,46' fill='" + sG + "'/>"
        digitsHtml = digitsHtml + "</svg>"
    }

    return "<div class='flex items-center justify-center p-3 bg-black rounded-2xl border-2 border-slate-900 shadow-2xl'>" + digitsHtml + "</div>"
}

// 3. 📟 16x2 Alphanumeric Character LCD Screen
fn danpheMatrixLCD(line1, line2, theme) {
    var t = theme || "emerald"
    var bg = "bg-emerald-950 border-emerald-600/40 text-emerald-400"
    if (t == "cyan") {
        bg = "bg-cyan-950 border-cyan-600/40 text-cyan-300"
    }
    if (t == "amber") {
        bg = "bg-amber-950 border-amber-600/40 text-amber-300"
    }

    var l1 = line1 || " "
    var l2 = line2 || ""
    var subHtml = ""
    if (len(l2) > 0) {
        subHtml = "<div class='text-xs opacity-75 mt-1 tracking-widest text-center'>" + l2 + "</div>"
    }
    return "<div class='flex-col p-3 rounded-2xl border-2 shadow-inner " + bg + " w-full font-mono font-bold tracking-widest'><div class='text-xl font-black tracking-wider text-center'>" + l1 + "</div>" + subHtml + "</div>"
}

// 4. 🎚️ 3D Studio Recessed Fader Slider
fn danpheProSlider(id, label, min, max, val, unit, color) {
    var c = color || "cyan"
    var u = unit || "%"
    var percent = (val - min) / (max - min) * 100
    var html = "<div class='danphe-pro-slider-group' id='slider-grp-" + id + "'>\n"
    html = html + "    <div class='slider-header-row'>\n"
    html = html + "        <span class='slider-title-txt'>" + label + "</span>\n"
    html = html + "        <span class='slider-val-badge' id='val-badge-" + id + "'>" + val + " " + u + "</span>\n"
    html = html + "    </div>\n"
    html = html + "    <div class='danphe-slider-track' onmousedown='startDanpheSliderDrag(event, `" + id + "`, " + min + ", " + max + ", `" + u + "`)'>\n"
    html = html + "        <div class='danphe-slider-fill " + c + "' id='fill-" + id + "' style='width: " + percent + "%;'></div>\n"
    html = html + "        <div class='danphe-slider-knob' id='knob-" + id + "' style='left: " + percent + "%;'></div>\n"
    html = html + "    </div>\n"
    html = html + "</div>\n"
    return html
}

// 5. 🎬 Workspace Switcher
fn danpheWorkspaceSwitcher(active) {
    var a = active || "edit"
    var tabs = [
        { "id": "edit", "label": "EDIT", "icon": "🎬" },
        { "id": "color", "label": "COLOR", "icon": "🎨" },
        { "id": "motion", "label": "MOTION / FX", "icon": "✨" },
        { "id": "audio", "label": "FAIRLIGHT", "icon": "🎙️" },
        { "id": "deliver", "label": "DELIVER", "icon": "🚀" }
    ]
    var html = "<div class='header-center-workspaces'>\n"
    loop (t in tabs) {
        var cls = "ws-pill-btn"
        if (t["id"] == a) {
            cls = "ws-pill-btn active"
        }
        var tid = t["id"]
        var ticon = t["icon"]
        var tlabel = t["label"]
        html = html + "    <button type='button' class='" + cls + "' onclick='switchNLEWorkspace(`" + tid + "`)'>" + ticon + " " + tlabel + "</button>\n"
    }
    html = html + "</div>"
    return html
}

var Danphe = {
    "version": "19.0.0-PRO",
    "Icon": danpheIcon,
    "getIcon": danpheIcon,
    "SevenSegment": danpheSevenSegment,
    "MatrixLCD": danpheMatrixLCD,
    "ProSlider": danpheProSlider,
    "WorkspaceSwitcher": danpheWorkspaceSwitcher
}
